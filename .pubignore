# NOTE: when this file exists, `pub publish` uses it INSTEAD of `.gitignore`,
# so anything `.gitignore` excludes is not excluded from the archive. Keep the
# two lists in sync.

# Local build, lockfile and test output (root only, matching .gitignore anchoring)
/pubspec.lock
/build/
/coverage/
.dart_tool/
/test/failures/

# Local-only planning, agent and IDE files. Not part of the package.
# Anchoring mirrors .gitignore exactly. A leading slash matters: `docs/` on its
# own would also drop `lib/docs/`, `test/docs/` and `example/docs/`, and `build/`
# would drop `lib/build/`. Only root-level copies are local-only.
/AGENTS.md
/CLAUDE.md
/GLOSSARY.md
/docs/
/.act/
/.mimocode/
/worktrees/
/handover.md
.idea/
.fvm/
.vscode/
migrate_working_dir/

*.iml
*.ipr
*.iws
*.log
*.class
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
.packages
.pub-cache/
.pub/
.flutter-plugins
.flutter-plugins-dependencies
**/doc/api/
lib/generated_plugin_registrant.dart

# Example build artifacts
example/build/
example/.dart_tool/
example/.idea/
example/.vscode/
example/.build/
example/.swiftpm/
example/coverage/
example/app.*.symbols
example/app.*.map.json
example/migrate_working_dir/

